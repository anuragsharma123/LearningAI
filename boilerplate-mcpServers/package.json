{
  "name": "mcp-server-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Boilerplate for writing MCP servers/tools, consumed by an MCP client (e.g. Claude Code) — no Claude/Anthropic API calls inside the server itself.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint src scripts --ext .ts",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "scaffold": "tsx scripts/scaffold.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
